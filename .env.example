# HandBrake MCP Server Configuration
# Copy this file to .env and modify as needed

# Server Configuration
HOST=127.0.0.1
PORT=10875
LOG_LEVEL=info
API_KEY=

# MCP Transport Configuration
MCP_TRANSPORT=stdio
MCP_HOST=127.0.0.1
MCP_PORT=10875

# HandBrake Configuration
# "HandBrakeCLI" resolves via PATH (winget alias on Windows, distro packaging on
# Linux). Set an absolute binary path if it is not on PATH.
HBB_PATH=HandBrakeCLI
# Optional comma-separated fallback locations probed when the PATH lookup misses
# (platform defaults: winget links dir on Windows, /usr/bin & /usr/local/bin on Linux)
# HBB_FALLBACK_PATHS=/usr/bin/HandBrakeCLI,/usr/local/bin/HandBrakeCLI
DEFAULT_PRESET=Fast 1080p30

# Watch Folder Configuration
WATCH_FOLDERS=
PROCESSED_FOLDER=
DELETE_ORIGINAL_AFTER_PROCESSING=false
FILE_PATTERNS=*.mp4,*.mkv,*.avi,*.mov,*.m4v

# MCP Bridge: comma-separated SSE URLs to proxy tools from other MCP servers
# MCP_BRIDGE_URLS=

# Notification Configuration
WEBHOOK_URL=
WEBHOOK_EVENTS=job_started,job_completed,job_failed
EMAIL_NOTIFICATIONS=false
EMAIL_RECIPIENTS=
EMAIL_SENDER=
